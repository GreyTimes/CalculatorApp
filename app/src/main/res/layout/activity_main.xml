<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:gravity="center"
    android:padding="16dp">

    <EditText
        android:id="@+id/editText2"
        android:layout_width="224dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="40sp"
        android:background="@android:color/transparent"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:hint="Enter the Value"
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        android:textColorHint="#555555"
        android:textSize="32sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/result"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textColor="#888888"
            android:text="Result: " />

        <TextView
            android:id="@+id/resultText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:text="0" />
    </LinearLayout>

    <TableLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:stretchColumns="0,1,2,3">

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/sin"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:backgroundTint="#1E1E1E"
                android:textSize="14sp"
                android:textColor="#CCCCCC"
                android:text="sin" />

            <Button
                android:id="@+id/cos"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:backgroundTint="#1E1E1E"
                android:textSize="14sp"
                android:textColor="#CCCCCC"
                android:text="cos" />

            <Button
                android:id="@+id/tan"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:backgroundTint="#1E1E1E"
                android:textSize="14sp"
                android:textColor="#CCCCCC"
                android:text="tan" />

            <Button
                android:id="@+id/sqrt"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:backgroundTint="#1E1E1E"
                android:textSize="14sp"
                android:textColor="#CCCCCC"
                android:text="√" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/square"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:backgroundTint="#1E1E1E"
                android:textSize="14sp"
                android:textColor="#CCCCCC"
                android:text="x²" />

            <Button
                android:id="@+id/power"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:backgroundTint="#1E1E1E"
                android:textSize="14sp"
                android:textColor="#CCCCCC"
                android:text="xʸ" />

            <Button
                android:id="@+id/log"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:backgroundTint="#1E1E1E"
                android:textSize="14sp"
                android:textColor="#CCCCCC"
                android:text="log" />

            <Button
                android:id="@+id/ln"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:backgroundTint="#1E1E1E"
                android:textSize="14sp"
                android:textColor="#CCCCCC"
                android:text="ln" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginBottom="8dp">
            <Button
                android:id="@+id/pi"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:backgroundTint="#1E1E1E"
                android:textSize="14sp"
                android:textColor="#CCCCCC"
                android:text="π" />

            <Button
                android:id="@+id/euler"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:backgroundTint="#1E1E1E"
                android:textSize="14sp"
                android:textColor="#CCCCCC"
                android:text="e" />

            <Button
                android:id="@+id/openParen"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:backgroundTint="#1E1E1E"
                android:textSize="14sp"
                android:textColor="#CCCCCC"
                android:text="(" />

            <Button
                android:id="@+id/closeParen"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:backgroundTint="#1E1E1E"
                android:textSize="14sp"
                android:textColor="#CCCCCC"
                android:text=")" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/num7"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:backgroundTint="#2A2A2A"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:text="7" />

            <Button
                android:id="@+id/num8"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:backgroundTint="#2A2A2A"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:text="8" />

            <Button
                android:id="@+id/num9"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:backgroundTint="#2A2A2A"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:text="9" />

            <Button
                android:id="@+id/mul"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:backgroundTint="#FF6F00"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:text="X" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/num4"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:backgroundTint="#2A2A2A"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:text="4" />

            <Button
                android:id="@+id/num5"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:backgroundTint="#2A2A2A"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:text="5" />

            <Button
                android:id="@+id/num6"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:backgroundTint="#2A2A2A"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:text="6" />

            <Button
                android:id="@+id/sub"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:backgroundTint="#FF6F00"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:text="-" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/num1"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:backgroundTint="#2A2A2A"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:text="1" />

            <Button
                android:id="@+id/num2"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:backgroundTint="#2A2A2A"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:text="2" />

            <Button
                android:id="@+id/num3"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:backgroundTint="#2A2A2A"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:text="3" />

            <Button
                android:id="@+id/add"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:backgroundTint="#FF6F00"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:text="+" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center">

            <Button
                android:id="@+id/zero"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:backgroundTint="#2A2A2A"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:text="0" />

            <Button
                android:id="@+id/dot"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:backgroundTint="#2A2A2A"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:text="." />

            <Button
                android:id="@+id/clear_text"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:backgroundTint="#3A2525"
                android:textSize="14sp"
                android:textColor="#FF8A8A"
                android:text="CE" />

            <Button
                android:id="@+id/div"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:backgroundTint="#FF6F00"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:text="/" />
        </TableRow>

    </TableLayout>

    <Button
        android:id="@+id/submit"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="#FF6F00"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:text="Submit" />
</LinearLayout>